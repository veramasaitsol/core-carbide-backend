    {
      "name": "Machine Data",
      "item": [
        {
          "name": "Insert Machine Data",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"machine_id\": 1,\n  \"machine_state\": \"RUNNING\",\n  \"machine_mode\": \"AUTO\",\n  \"axis_positions\": { \"X\": 10.5, \"Y\": -5.2, \"Z\": 100.0 },\n  \"actual_spindle_speed\": 1500,\n  \"set_speed\": 1500,\n  \"actual_feed_rate\": 200,\n  \"set_feed_rate\": 200,\n  \"feed_override\": 100,\n  \"speed_override\": 100,\n  \"spindle_load\": 45,\n  \"coolant_status\": \"ON\",\n  \"cycle_time\": \"00:02:30\",\n  \"cutting_time\": \"00:01:45\",\n  \"operate_time\": \"08:00:00\",\n  \"power_on_time\": \"08:30:00\",\n  \"current_tool_number\": 3,\n  \"total_production\": 120,\n  \"main_program_number\": \"O1001\",\n  \"executing_program_number\": \"O1001\",\n  \"sequence_number\": \"N100\",\n  \"emergency_signal\": 0,\n  \"battery_low_alarm\": 0,\n  \"machine_alarms\": [],\n  \"cnc_warnings\": []\n}"
            },
            "url": { "raw": "{{base_url}}/api/machine_data", "host": ["{{base_url}}"], "path": ["api", "machine_data"] }
          }
        },
        {
          "name": "Get Machine Data (Latest)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{base_url}}/machine_data/1",
              "host": ["{{base_url}}"],
              "path": ["machine_data", "1"]
            }
          }
        },
        {
          "name": "Get Machine Data (Date Range)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{base_url}}/machine_data/1?start_time=2025-01-01 00:00:00&end_time=2025-01-31 23:59:59",
              "host": ["{{base_url}}"],
              "path": ["machine_data", "1"],
              "query": [
                { "key": "start_time", "value": "2025-01-01 00:00:00" },
                { "key": "end_time", "value": "2025-01-31 23:59:59" }
              ]
            }
          }
        },
